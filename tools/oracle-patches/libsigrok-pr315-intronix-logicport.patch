From 9692e2494dd387357243c4593ff9d1a426f3e8dc Mon Sep 17 00:00:00 2001
From: Miguel Angel Ajo Pelayo <miguelangel@ajo.es>
Date: Mon, 19 Oct 2026 15:36:31 +0200
Subject: [PATCH 6/6] intronix-logicport: Only compress on enabled channels.

The compression mask register selects which channels can start a new
RLE entry. It was always set to all channels, so with RLE enabled any
change on a disabled channel (e.g. a floating input picking up noise)
used up sample memory. Set it to the enabled channels instead, or to
all channels when none is enabled.

Measured with a 1 kHz clock on CLK1 and bursts on other inputs, at
1 MHz with RLE: the capture lasts 0.51 s with only CLK1 enabled, versus
0.03 s with all channels enabled.
---
 src/hardware/intronix-logicport/api.c      | 18 ++++++++++++++++++
 src/hardware/intronix-logicport/protocol.c |  8 ++++++--
 src/hardware/intronix-logicport/protocol.h |  2 ++
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/hardware/intronix-logicport/api.c b/src/hardware/intronix-logicport/api.c
index 99805f23..41fa73b9 100644
--- a/src/hardware/intronix-logicport/api.c
+++ b/src/hardware/intronix-logicport/api.c
@@ -416,12 +416,30 @@ static int prepare(const struct sr_dev_inst *sdi)
 	return logicport_program(devc);
 }
 
+/* Bit k set for each enabled channel k; all channels if none is enabled. */
+static uint64_t enabled_channels_mask(const struct sr_dev_inst *sdi)
+{
+	const struct sr_channel *ch;
+	const GSList *l;
+	uint64_t mask;
+
+	mask = 0;
+	for (l = sdi->channels; l; l = l->next) {
+		ch = l->data;
+		if (ch->enabled && ch->index < LOGICPORT_NUM_CHANNELS)
+			mask |= UINT64_C(1) << ch->index;
+	}
+
+	return mask ? mask : LOGICPORT_ALL_CHANNELS;
+}
+
 static int dev_acquisition_start(const struct sr_dev_inst *sdi)
 {
 	struct dev_context *devc;
 	int ret;
 
 	devc = sdi->priv;
+	devc->compression_mask = enabled_channels_mask(sdi);
 
 	if (devc->rle && !devc->external_clock &&
 	    devc->rate->samplerate > LOGICPORT_RLE_MAX_RATE) {
diff --git a/src/hardware/intronix-logicport/protocol.c b/src/hardware/intronix-logicport/protocol.c
index 0902da6b..78eec1b0 100644
--- a/src/hardware/intronix-logicport/protocol.c
+++ b/src/hardware/intronix-logicport/protocol.c
@@ -1139,8 +1139,12 @@ SR_PRIV int logicport_program(struct dev_context *devc)
 
 	queue_reg(&q, REG_CLOCK_MODE, 1, mode);
 	queue_reg(&q, REG_COMPRESSION, 1, 0);
-	/* All channels are always captured, this only steers compression. */
-	queue_reg(&q, REG_COMPRESSION_MASK, 5, LOGICPORT_ALL_CHANNELS);
+	/*
+	 * All channels are always captured, this only steers compression:
+	 * changes on channels outside the mask don't start a new RLE entry,
+	 * so disabled (e.g. floating) inputs don't fill the sample memory.
+	 */
+	queue_reg(&q, REG_COMPRESSION_MASK, 5, devc->compression_mask);
 	queue_reg(&q, REG_INVERT_MASK, 5, 0);
 	queue_reg(&q, REG_COMPRESSION, 1, devc->rle ? 1 : 0);
 	queue_reg(&q, REG_CHANNEL_CFG, 1, 0);
diff --git a/src/hardware/intronix-logicport/protocol.h b/src/hardware/intronix-logicport/protocol.h
index a6211ed7..59fd724f 100644
--- a/src/hardware/intronix-logicport/protocol.h
+++ b/src/hardware/intronix-logicport/protocol.h
@@ -120,6 +120,8 @@ struct dev_context {
 
 	/* Acquisition state. */
 	gboolean acq_running;
+	/* Channels RLE compression watches: the enabled ones. */
+	uint64_t compression_mask;
 	uint64_t frames_done;
 	/* RLE only: time limits for the pre-/post-trigger fill phases. */
 	gint64 acq_start;
-- 
