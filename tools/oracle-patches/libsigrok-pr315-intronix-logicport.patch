From 97d6588849b0f2a5488aac050ffac933c45c3e0c Mon Sep 17 00:00:00 2001
From: Miguel Angel Ajo Pelayo <miguelangel@ajo.es>
Date: Sun, 18 Oct 2026 19:35:49 +0200
Subject: [PATCH 4/6] intronix-logicport: Add frame limit support.

With SR_CONF_LIMIT_FRAMES set, each capture is sent as a frame and the
device is re-armed until the limit is reached (recurring acquisition).
---
 src/hardware/intronix-logicport/api.c      |  8 ++++++++
 src/hardware/intronix-logicport/protocol.c | 23 +++++++++++++++++++++-
 src/hardware/intronix-logicport/protocol.h |  2 ++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/hardware/intronix-logicport/api.c b/src/hardware/intronix-logicport/api.c
index 7adccb8e..99805f23 100644
--- a/src/hardware/intronix-logicport/api.c
+++ b/src/hardware/intronix-logicport/api.c
@@ -46,6 +46,7 @@ static const uint32_t devopts[] = {
 	SR_CONF_CONN | SR_CONF_GET,
 	SR_CONF_SAMPLERATE | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
 	SR_CONF_LIMIT_SAMPLES | SR_CONF_GET | SR_CONF_SET,
+	SR_CONF_LIMIT_FRAMES | SR_CONF_GET | SR_CONF_SET,
 	SR_CONF_CAPTURE_RATIO | SR_CONF_GET | SR_CONF_SET,
 	SR_CONF_TRIGGER_MATCH | SR_CONF_LIST,
 	SR_CONF_VOLTAGE_THRESHOLD | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
@@ -269,6 +270,9 @@ static int config_get(uint32_t key, GVariant **data,
 	case SR_CONF_LIMIT_SAMPLES:
 		*data = g_variant_new_uint64(devc->limit_samples);
 		break;
+	case SR_CONF_LIMIT_FRAMES:
+		*data = g_variant_new_uint64(devc->limit_frames);
+		break;
 	case SR_CONF_CAPTURE_RATIO:
 		*data = g_variant_new_uint64(devc->capture_ratio);
 		break;
@@ -317,6 +321,9 @@ static int config_set(uint32_t key, GVariant *data,
 	case SR_CONF_LIMIT_SAMPLES:
 		devc->limit_samples = g_variant_get_uint64(data);
 		break;
+	case SR_CONF_LIMIT_FRAMES:
+		devc->limit_frames = g_variant_get_uint64(data);
+		break;
 	case SR_CONF_CAPTURE_RATIO:
 		ratio = g_variant_get_uint64(data);
 		if (ratio > 100)
@@ -442,6 +449,7 @@ static int dev_acquisition_start(const struct sr_dev_inst *sdi)
 		return ret;
 	}
 	devc->acq_running = TRUE;
+	devc->frames_done = 0;
 	sr_dbg("Acquisition armed.");
 
 	std_session_send_df_header(sdi);
diff --git a/src/hardware/intronix-logicport/protocol.c b/src/hardware/intronix-logicport/protocol.c
index f2b5090d..0902da6b 100644
--- a/src/hardware/intronix-logicport/protocol.c
+++ b/src/hardware/intronix-logicport/protocol.c
@@ -1536,6 +1536,7 @@ SR_PRIV int logicport_receive_data(int fd, int revents, void *cb_data)
 	struct sr_dev_inst *sdi;
 	struct dev_context *devc;
 	uint8_t status;
+	int ret;
 
 	(void)fd;
 	(void)revents;
@@ -1564,8 +1565,28 @@ SR_PRIV int logicport_receive_data(int fd, int revents, void *cb_data)
 	sr_dbg("Acquisition done, status 0x%02x.", status);
 	devc->acq_running = FALSE;
 
-	if (read_samples(sdi, status) != SR_OK)
+	/* With a frame limit, each capture is a frame, then re-arm. */
+	if (devc->limit_frames)
+		std_session_send_df_frame_begin(sdi);
+	ret = read_samples(sdi, status);
+	if (devc->limit_frames)
+		std_session_send_df_frame_end(sdi);
+	if (ret != SR_OK) {
 		sr_err("Failed to read sample memory.");
+		sr_dev_acquisition_stop(sdi);
+		return TRUE;
+	}
+
+	devc->frames_done++;
+	if (devc->frames_done < devc->limit_frames) {
+		if (logicport_start(devc) != SR_OK) {
+			sr_err("Failed to re-arm for the next frame.");
+			sr_dev_acquisition_stop(sdi);
+			return TRUE;
+		}
+		devc->acq_running = TRUE;
+		return TRUE;
+	}
 	sr_dev_acquisition_stop(sdi);
 
 	return TRUE;
diff --git a/src/hardware/intronix-logicport/protocol.h b/src/hardware/intronix-logicport/protocol.h
index 342b31a7..a6211ed7 100644
--- a/src/hardware/intronix-logicport/protocol.h
+++ b/src/hardware/intronix-logicport/protocol.h
@@ -110,6 +110,7 @@ struct dev_context {
 	/* User settings. */
 	const struct logicport_rate *rate;
 	uint64_t limit_samples;
+	uint64_t limit_frames;
 	uint64_t capture_ratio;
 	double threshold;
 	gboolean rle;
@@ -119,6 +120,7 @@ struct dev_context {
 
 	/* Acquisition state. */
 	gboolean acq_running;
+	uint64_t frames_done;
 	/* RLE only: time limits for the pre-/post-trigger fill phases. */
 	gint64 acq_start;
 	gint64 trigger_seen;
-- 
